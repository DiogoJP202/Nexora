# Copy to /etc/nexora/common.env as root:root 0600; UTF-8 without BOM.
# systemd EnvironmentFile syntax, not a shell script. Never source this file.
# Replace the password locally using sudoedit; never commit the real file.
# Values must be single-line, optionally quoted as a whole, without backslashes.
NEXORA_Storage__RootPath=/srv/nexora
NEXORA_ConnectionStrings__Nexora="Host=127.0.0.1;Port=5432;Database=nexora;Username=nexora;Password=REPLACE_WITH_RUNTIME_PASSWORD;Pooling=true;Log Parameters=false;Include Error Detail=false;Persist Security Info=false"

# Application storage admission: keep 50 GiB free and reserve at most 50 GiB.
# These are application limits, not filesystem quotas or available disk space.
NEXORA_Uploads__MinimumFreeBytes=53687091200
NEXORA_Uploads__MaximumReservedBytes=53687091200
NEXORA_Uploads__MaximumFileSizeBytes=21474836480
NEXORA_Uploads__ChunkSizeBytes=8388608

# Preserve sanitized production logs. Request bodies/headers are not logged.
NEXORA_Logging__LogLevel__Default=Information
NEXORA_Logging__LogLevel__Microsoft=Warning
