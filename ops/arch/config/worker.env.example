# Copy to /etc/nexora/worker.env as root:root 0600; never source this file.
# The reviewed cgroup budget includes the parent and its decoder child.
# 512 MiB is the child's observed working-set limit; native peaks are sampled.
NEXORA_Images__MaximumProcessMemoryBytes=536870912
NEXORA_Images__MaximumInputBytes=33554432
NEXORA_Images__MaximumDecodedBytes=134217728
NEXORA_Images__MaximumDerivativeBytes=8388608
NEXORA_Images__MaximumPixels=24000000
NEXORA_Images__ProcessingTimeout=00:00:30
