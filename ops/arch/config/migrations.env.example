# Copy to /etc/nexora/migrations.env as root:root 0600; never source this file.
# Only the explicit migration job receives this file, AFTER common.env/api.env.
# The API, Worker and bootstrap-admin continue using the nexora runtime role.
NEXORA_ConnectionStrings__Nexora="Host=127.0.0.1;Port=5432;Database=nexora;Username=nexora_migrator;Password=REPLACE_WITH_MIGRATOR_PASSWORD;Pooling=false;Log Parameters=false;Include Error Detail=false;Persist Security Info=false"
