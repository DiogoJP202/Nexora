# Copy to /etc/nexora/api.env as root:root 0600; never source this file.
# Replace this sample with the exact FQDN returned by Tailscale on the host.
# AllowedHosts uses semicolons, no ports, schemes or wildcard entries.
NEXORA_AllowedHosts=localhost;127.0.0.1;nexora.REPLACE_TAILNET.ts.net
NEXORA_DataProtection__KeyDirectory=/var/lib/nexora/keys
NEXORA_DataProtection__CertificatePath=/etc/nexora/data-protection.pfx
# Match the PFX export password entered locally during OpenSSL creation.
NEXORA_DataProtection__CertificatePassword=REPLACE_WITH_PFX_PASSWORD
